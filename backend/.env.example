NODE_ENV=development
PORT=3000

# Railway te da esta URL en la pestaña "Connect" del servicio Postgres
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

CORS_ORIGIN=http://localhost:5173

# Cloudflare R2 (almacenamiento de fotos de clientes, compatible con S3).
# Dashboard: dash.cloudflare.com > R2 Object Storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cosmostrak-fotos
# URL pública del bucket (R2.dev o dominio propio), sin barra final.
R2_PUBLIC_URL_BASE=https://pub-xxxxxxxx.r2.dev

# SMTP de info@cosmostrak.com.py (hosting del dominio, cPanel). Puerto 465 = SSL,
# puerto 587 = STARTTLS (ahí SMTP_SECURE=false).
SMTP_HOST=mail.cosmostrak.com.py
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@cosmostrak.com.py
SMTP_PASSWORD=
MAIL_FROM=Cosmostrak <info@cosmostrak.com.py>
